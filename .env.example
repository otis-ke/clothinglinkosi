# Copy to ".env.local" and fill in values. Create React App exposes only vars prefixed with REACT_APP_.

# --- Firebase (web app) ---
REACT_APP_FIREBASE_API_KEY=FIREBASE_API_KEY
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=FIREBASE_PROJECT_ID
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
# Required for checkout orders (Realtime Database)
REACT_APP_FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com

# --- Cloudinary (admin uploads) ---
# Cloud name only (public). NEVER put API Key or API Secret in REACT_APP_* — they ship in JS.
REACT_APP_CLOUDINARY_CLOUD_NAME=CLOUDINARY_CLOUD_NAME
# Unsigned upload preset name (Dashboard → Upload → Upload presets)
REACT_APP_CLOUDINARY_UPLOAD_PRESET=CLOUDINARY_UPLOAD_PRESET
# Media files stay on Cloudinary; Firestore stores returned secure_url strings (Firebase Storage optional).
#
# Firebase Storage fallback: enable Authentication → Anonymous; deploy firebase.storage.rules
# (writes to admin_uploads/ require ANY signed-in Firebase user — admin panel signs you in anonymously).

